
# ============================================================
# PHISHING EMAIL DETECTION MODEL
# Dataset: phishing_legit_dataset_KD_10000.csv
# Model: TF-IDF + Logistic Regression
# Output: phishing_model.pkl
# ============================================================

import json
from pathlib import Path

import joblib
import pandas as pd

from sklearn.model_selection import train_test_split
from sklearn.pipeline import Pipeline
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.linear_model import LogisticRegression

from sklearn.metrics import (
    accuracy_score,
    balanced_accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    confusion_matrix,
    classification_report,
    roc_auc_score,
    average_precision_score
)


# ------------------------------------------------------------
# 1. FILE SETTINGS
# ------------------------------------------------------------

BASE_DIR = Path(__file__).resolve().parent

DATASET_FILE = BASE_DIR / "phishing_legit_dataset_KD_10000.csv"
MODEL_FILE = BASE_DIR / "phishing_model.pkl"
RESULTS_FILE = BASE_DIR / "phishing_model_evaluation.json"

RANDOM_STATE = 42
TEST_SIZE = 0.20


# ------------------------------------------------------------
# 2. LOAD THE DATASET
# ------------------------------------------------------------

print("=" * 60)
print("PHISHING EMAIL DETECTION MODEL")
print("=" * 60)

if not DATASET_FILE.exists():
    raise FileNotFoundError(
        f"\nDataset not found: {DATASET_FILE}\n"
        "Place phishing_legit_dataset_KD_10000.csv "
        "in the same folder as this script."
    )

df = pd.read_csv(DATASET_FILE)

TEXT_COLUMN = "text"
LABEL_COLUMN = "label"

required_columns = {TEXT_COLUMN, LABEL_COLUMN}

if not required_columns.issubset(df.columns):
    raise ValueError(
        "The dataset must contain these columns: "
        "'text' and 'label'.\n"
        f"Columns found: {df.columns.tolist()}"
    )

print("\nOriginal dataset rows:", len(df))
print("Dataset columns:", df.columns.tolist())


# ------------------------------------------------------------
# 3. CLEAN AND VALIDATE THE DATA
# ------------------------------------------------------------

df = df[[TEXT_COLUMN, LABEL_COLUMN]].copy()

df[TEXT_COLUMN] = df[TEXT_COLUMN].fillna("").astype(str).str.strip()

# Convert labels into numeric values.
df[LABEL_COLUMN] = pd.to_numeric(
    df[LABEL_COLUMN],
    errors="coerce"
)

# Remove missing labels and empty email text.
df = df.dropna(subset=[LABEL_COLUMN])
df = df[df[TEXT_COLUMN] != ""]

# Keep only the expected binary labels: 0 and 1.
df = df[df[LABEL_COLUMN].isin([0, 1])]

df[LABEL_COLUMN] = df[LABEL_COLUMN].astype(int)

# Remove exact duplicate email texts before splitting.
df = df.drop_duplicates(subset=[TEXT_COLUMN]).reset_index(drop=True)

if df[LABEL_COLUMN].nunique() != 2:
    raise ValueError(
        "Both label classes must exist: "
        "0 = legitimate, 1 = phishing."
    )

print("\nRows after cleaning:", len(df))
print("\nLabel distribution:")
print(df[LABEL_COLUMN].value_counts().sort_index())

print("\nLabel meanings:")
print("0 = Legitimate email")
print("1 = Phishing email")


# ------------------------------------------------------------
# 4. PREPARE TRAINING AND TESTING DATA
# ------------------------------------------------------------

X = df[TEXT_COLUMN]
y = df[LABEL_COLUMN]

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=TEST_SIZE,
    random_state=RANDOM_STATE,
    stratify=y
)

print("\nTraining samples:", len(X_train))
print("Testing samples:", len(X_test))


# ------------------------------------------------------------
# 5. BUILD THE MACHINE LEARNING PIPELINE
# ------------------------------------------------------------

model = Pipeline([
    (
        "tfidf",
        TfidfVectorizer(
            lowercase=True,
            ngram_range=(1, 2),
            max_features=20000,
            sublinear_tf=True,
            strip_accents="unicode"
        )
    ),
    (
        "classifier",
        LogisticRegression(
            max_iter=1000,
            class_weight="balanced",
            random_state=RANDOM_STATE
        )
    )
])


# ------------------------------------------------------------
# 6. TRAIN THE MODEL
# ------------------------------------------------------------

print("\nTraining the phishing classifier...")
model.fit(X_train, y_train)

print("Training completed.")


# ------------------------------------------------------------
# 7. EVALUATE ON UNSEEN TEST DATA
# ------------------------------------------------------------

predictions = model.predict(X_test)

# Probability assigned to the phishing class.
phishing_probabilities = model.predict_proba(X_test)[:, 1]

accuracy = accuracy_score(y_test, predictions)
balanced_accuracy = balanced_accuracy_score(y_test, predictions)

precision = precision_score(
    y_test, predictions, zero_division=0
)

recall = recall_score(
    y_test, predictions, zero_division=0
)

f1 = f1_score(
    y_test, predictions, zero_division=0
)

roc_auc = roc_auc_score(y_test, phishing_probabilities)

average_precision = average_precision_score(
    y_test, phishing_probabilities
)

matrix = confusion_matrix(
    y_test,
    predictions,
    labels=[0, 1]
)

tn, fp, fn, tp = matrix.ravel()

false_positive_rate = (
    fp / (fp + tn) if (fp + tn) > 0 else 0.0
)


# ------------------------------------------------------------
# 8. DISPLAY THE RESULTS
# ------------------------------------------------------------

print("\n" + "=" * 60)
print("MODEL EVALUATION RESULTS")
print("=" * 60)

print(f"Accuracy:              {accuracy:.4f}")
print(f"Balanced accuracy:     {balanced_accuracy:.4f}")
print(f"Phishing precision:    {precision:.4f}")
print(f"Phishing recall:       {recall:.4f}")
print(f"Phishing F1-score:     {f1:.4f}")
print(f"ROC-AUC:               {roc_auc:.4f}")
print(f"Average precision:     {average_precision:.4f}")
print(f"False-positive rate:   {false_positive_rate:.4f}")

print("\nConfusion Matrix")
print("Rows = actual; columns = predicted")
print("Class order: 0 = Legitimate, 1 = Phishing")
print(matrix)

print("\nClassification Report")
print(
    classification_report(
        y_test,
        predictions,
        labels=[0, 1],
        target_names=["Legitimate", "Phishing"],
        zero_division=0
    )
)

print("Confusion matrix interpretation:")
print("True negatives (legitimate correctly identified):", tn)
print("False positives (legitimate flagged as phishing):", fp)
print("False negatives (phishing missed):", fn)
print("True positives (phishing correctly identified):", tp)


# ------------------------------------------------------------
# 9. SAVE EVALUATION RESULTS
# ------------------------------------------------------------

results = {
    "dataset_file": DATASET_FILE.name,
    "original_rows": int(len(pd.read_csv(DATASET_FILE))),
    "cleaned_rows": int(len(df)),
    "training_rows": int(len(X_train)),
    "testing_rows": int(len(X_test)),
    "random_state": RANDOM_STATE,
    "test_size": TEST_SIZE,
    "label_mapping": {
        "0": "Legitimate",
        "1": "Phishing"
    },
    "accuracy": float(accuracy),
    "balanced_accuracy": float(balanced_accuracy),
    "phishing_precision": float(precision),
    "phishing_recall": float(recall),
    "phishing_f1_score": float(f1),
    "roc_auc": float(roc_auc),
    "average_precision": float(average_precision),
    "false_positive_rate": float(false_positive_rate),
    "confusion_matrix": {
        "true_negatives": int(tn),
        "false_positives": int(fp),
        "false_negatives": int(fn),
        "true_positives": int(tp)
    }
}

with open(RESULTS_FILE, "w", encoding="utf-8") as file:
    json.dump(results, file, indent=4)

print("\nEvaluation results saved to:")
print(RESULTS_FILE.name)


# ------------------------------------------------------------
# 10. SAVE THE TRAINED MODEL
# ------------------------------------------------------------

joblib.dump(model, MODEL_FILE)

print("\nTrained model saved to:")
print(MODEL_FILE.name)

print("\nIMPORTANT:")
print("- This is a separate phishing model.")
print("- Your existing pei_model.pkl is not modified.")
print("- Evaluation results come from the held-out test set.")
print("- Test performance does not guarantee real-world accuracy.")

print("\n" + "=" * 60)
print("PROCESS COMPLETED")
print("=" * 60)
